# Built binaries and local reports
/riskelle
/dist/
*.risk-report.json

# Agent and developer tooling is personal setup, not repo/team bound
.claude/
.grok/
.pi/
.codex/
.gemini/
.cursor/
CLAUDE.md
AGENTS.md

# >>> satelle (managed) >>>
# satelle adds only entries it needs that this file does not already settle;
# the operator owns .gitignore and any rule written here or elsewhere is kept.
# Runtime state lives under ~/.satelle/<repo-key>/, outside the repo.
sty_*_body.md
sty_*_ac.md
.satelle/**/.env
.satelle/logs
.satelle/hooks
.satelle/deployed.version
.satelle/*.local.toml
.satelle/workflows/agents.local.toml
.satelle/satelle
.satelle/tasks/*/exe_*.md
!.satelle/
# <<< satelle (managed) <<<

# Operator (2026-11-04): .satelle/ substrate is tracked in git. Task run
# outputs, backups and any local/db state stay machine-local.
.satelle/tasks/*/
.satelle/backups/
.satelle/**/*.bak
.satelle/**/*.bak-*
.satelle/**/*.local.*
.satelle/**/*.db*
